# Copier ce fichier en .env, puis remplacer les valeurs fictives.
# Le fichier .env est ignoré par Git : ne jamais le commiter.

# Environnement : development, test ou production
NODE_ENV=development

# Port du serveur
PORT=3000

# Connexion PostgreSQL (valeur fictive)
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/sciti

# Mot de passe commun des comptes de démonstration créés par « npm run seed ».
# Uniquement pour les données fictives, jamais pour un vrai compte.
SEED_DEMO_PASSWORD=changer-moi-demo
