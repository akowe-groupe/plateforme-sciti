# Copier ce fichier en .env, puis remplacer les valeurs fictives.
# Le fichier .env est ignoré par Git : ne jamais le commiter.

# Environnement : development, test ou production
NODE_ENV=development

# Port du serveur
PORT=3000

# Connexion PostgreSQL (valeur fictive)
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/sciti

# Mot de passe commun des comptes de démonstration créés par « npm run seed ».
# Uniquement pour les données fictives, jamais pour un vrai compte.
SEED_DEMO_PASSWORD=changer-moi-demo

# Secret de signature des jetons de session : au moins 32 caractères aléatoires.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changer-moi-par-une-longue-valeur-aleatoire-de-32-caracteres-min

# Déconnexion après cette durée sans activité (30m, 2h...).
JWT_EXPIRES_IN=30m

# Tentatives de connexion échouées autorisées par adresse IP et par quart d'heure.
LOGIN_MAX_ATTEMPTS=10
