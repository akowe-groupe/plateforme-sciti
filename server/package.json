{
  "name": "sciti-server",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de la plateforme étudiante SCITI (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file=.env node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "node --env-file=.env node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:rollback",
    "seed": "node --env-file=.env node_modules/knex/bin/cli.js --knexfile knexfile.js seed:run",
    "db:reset": "npm run migrate:rollback -- --all && npm run migrate && npm run seed",
    "test": "node --env-file=.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
